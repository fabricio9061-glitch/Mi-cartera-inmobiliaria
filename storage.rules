// ============================================
// REGLAS DE FIREBASE STORAGE — MALAVE
// ============================================
// Reemplazá TODO el contenido en Firebase Console -> Storage -> Rules -> Publicar
// ============================================
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isLoggedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email.lower() == 'fabricio9061@gmail.com';
    }
    // ¿Cuenta APROBADA? Cualquiera puede registrarse (queda 'pending'), así que
    // "logueado" equivale a "cualquier persona de internet". Se lee el perfil en
    // Firestore (reglas cruzadas Storage -> Firestore). La primera vez que se
    // publica, Firebase pide autorizar ese acceso: aceptarlo.
    function isApproved() {
      return isAdmin() || (request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'approved');
    }
    // Agente asociado (paga para publicar en la web): sube las fotos de SUS
    // propiedades y su foto de perfil, nada más. Ver esAsociado en firestore.rules.
    function isInterno() {
      return isApproved() && (isAdmin() ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('rank', '') != 'agente_asociado');
    }
    // Límite de tamaño por archivo (25 MB) para no disparar costos.
    function sizeOk() {
      return request.resource.size < 25 * 1024 * 1024;
    }
    // Solo imágenes (evita subir HTML/JS y que quede hosteado en el dominio de Storage).
    function esImagen() {
      return request.resource.contentType.matches('image/.*');
    }
    // ============================================
    // FOTOS DE PERFIL DE LOS AGENTES
    // La app las guarda en users/{uid}/  -> cada agente sube SOLO la suya, todos las ven
    // (ESTE era el bloque que faltaba: por eso daba "unauthorized")
    // ============================================
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isLoggedIn() && request.auth.uid == userId && sizeOk() && esImagen();
    }
    // ============================================
    // FOTOS DE PROPIEDADES
    // ============================================
    match /properties/{propId}/{allPaths=**} {
      allow read: if true;                                  // las fotos se ven en la web pública
      // Antes: cualquier logueado (incluso sin aprobar) podía subir o pisar las
      // fotos de cualquier propiedad.
      // El agente asociado, solo en la carpeta de una propiedad SUYA o de una que
      // todavía no existe (las fotos se suben antes de guardar la propiedad).
      allow write: if isApproved() && sizeOk() && esImagen()
                   && (isInterno()
                       || !firestore.exists(/databases/(default)/documents/properties/$(propId))
                       || firestore.get(/databases/(default)/documents/properties/$(propId)).data.ownerId == request.auth.uid);
    }
    // ============================================
    // FOTOS DE PERFIL (carpeta vieja, por si quedó algo ahí)
    // ============================================
    match /profilePhotos/{allPaths=**} {
      allow read: if true;
      allow write: if isApproved() && sizeOk() && esImagen();
    }
    // ============================================
    // DOCUMENTOS OFICIALES — todos los logueados descargan, SOLO admin sube/borra
    // ============================================
    match /documentos/{allPaths=**} {
      allow read: if isInterno();
      allow write: if isAdmin() && sizeOk();
    }
    // ============================================
    // MALAVE ACADEMY — todos los logueados ven, SOLO admin sube/borra
    // ============================================
    match /academy/{allPaths=**} {
      allow read: if isInterno();
      allow write: if isAdmin() && sizeOk();
    }
    // ============================================
    // PROPIEDADES COMPARTIDAS — logueados ven y suben
    // ============================================
    match /compartidas/{allPaths=**} {
      allow read: if isInterno();
      allow write: if isInterno() && sizeOk();
    }
    // ============================================
    // PDFs DE TASACIONES PARA REVISIÓN
    // Copia temporal del informe. Se borra automáticamente cuando el admin
    // marca la tasación como revisada. Logueados suben/leen/borran.
    // ============================================
    // Traen nombre del cliente y dirección del inmueble: solo cuentas aprobadas
    // (antes cualquier cuenta recién registrada los podía bajar).
    match /tasacionesPDF/{allPaths=**} {
      allow read: if isInterno();
      allow write: if isInterno() && sizeOk();
    }
    // ============================================
    // IMÁGENES DE RECOMPENSAS — todos las ven, SOLO admin sube/borra
    // ============================================
    match /recompensasIMG/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && sizeOk() && esImagen();
    }
    // ============================================
    // CV DE POSTULACIONES — "Trabajá con nosotros"
    // --------------------------------------------
    // ES EL ÚNICO BLOQUE DONDE ESCRIBE GENTE SIN LOGUEAR: el formulario está en
    // la web pública y quien se postula no tiene cuenta. Por eso los límites son
    // más estrictos que en el resto.
    //
    // LEER: solo el admin. Un CV trae cédula, teléfono, domicilio y a veces foto:
    // es dato personal de alguien que no es cliente ni agente. No va público
    // aunque el resto de las carpetas de archivos lo sean.
    //
    // BORRAR: solo el admin, desde el panel, cuando la postulación no sirve.
    //
    // Sin este bloque la subida fallaría: la regla del final bloquea todo lo que
    // no esté nombrado.
    // ============================================
    function cvValido() {
      // 10 MB alcanza de sobra para un CV, incluso escaneado con fotos.
      return request.resource.size < 10 * 1024 * 1024 &&
             (request.resource.contentType.matches('image/.*') ||
              request.resource.contentType == 'application/pdf' ||
              request.resource.contentType == 'application/msword' ||
              request.resource.contentType ==
                'application/vnd.openxmlformats-officedocument.wordprocessingml.document');
    }
    match /postulaciones/{allPaths=**} {
      allow read: if isAdmin();
      allow create: if cvValido();      // público, pero acotado
      allow update: if false;           // un CV subido no se reemplaza
      allow delete: if isAdmin();
    }
    // ============================================
    // DOCUMENTOS GENERADOS — el PDF de cada documento, tal cual salió
    // --------------------------------------------
    // Contratos, recibos e inventarios traen cédulas, direcciones y cuentas.
    // Cada PDF va en la carpeta de quien lo generó y solo esa persona lo lee
    // directo; la Dirección lo abre con el enlace del registro (que solo ven la
    // Dirección y el autor, ver firestore.rules).
    // Un PDF guardado no se reemplaza ni se borra: una versión nueva es otro
    // archivo.
    // ============================================
    match /documentosGenerados/{uid}/{allPaths=**} {
      allow read: if isLoggedIn() && request.auth.uid == uid;
      allow create: if isLoggedIn() && request.auth.uid == uid
                    && isInterno()
                    && sizeOk()
                    && request.resource.contentType == 'application/pdf';
      allow update, delete: if false;
    }
    // ============================================
    // CUALQUIER OTRA RUTA — bloqueada por defecto
    // ============================================
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
