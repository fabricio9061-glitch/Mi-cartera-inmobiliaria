rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email.lower() == 'fabricio9061@gmail.com';
    }

    // ¿La cuenta está aprobada? (el admin siempre cuenta como aprobado).
    // Antes el approval era solo del lado del navegador: un usuario 'pending' o
    // 'rejected' con su token podía leer/editar datos por SDK. Ahora se exige acá.
    function isApproved() {
      return isAdmin() ||
             (request.auth != null &&
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved');
    }

    function perfil() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // DIRECCIÓN = CEO y COO. Es el permiso que antes era isAdmin() a secas.
    // El correo del CEO queda como red de seguridad: si su perfil se quedara sin
    // rango cargado, seguiría entrando igual y podría arreglarlo desde el panel.
    // Se exige 'approved': un COO con la cuenta suspendida no manda nada.
    // Nota de costo: el get() de perfil() se repite en varias funciones, pero
    // Firestore cachea las lecturas al MISMO documento dentro de una evaluación,
    // así que se cobra una sola.
    function esDireccion() {
      return isAdmin() || (
        request.auth != null &&
        perfil().get('rank', '') in ['ceo', 'coo'] &&
        perfil().get('status', '') == 'approved'
      );
    }
    // Alias histórico: la agenda ya lo usaba con este nombre.
    function rangoVeTodo() { return esDireccion(); }

    // AGENTE ASOCIADO: agente de afuera que paga una cuota para publicar en la
    // web. Está aprobado (entra al CRM) pero NO es del equipo: ve y edita solo
    // sus propiedades, su perfil, su agenda, sus avisos y la Academy. No ve
    // clientes, gestiones, finanzas, puntos, tasaciones, cuentas de portales,
    // documentos ni el resto de la cartera de MALAVE.
    // isInterno() es "aprobado y del equipo": va en lugar de isApproved() en todo
    // lo que es solo de MALAVE.
    function esAsociado() {
      return request.auth != null && !isAdmin()
          && perfil().get('rank', '') == 'agente_asociado';
    }
    function isInterno() { return isApproved() && !esAsociado(); }
    // Cuota al día: sin fecha cargada no vence. Vencida, no sube ni edita.
    function asociadoAlDia() {
      return perfil().get('asociadoHasta', null) == null
          || perfil().get('asociadoHasta', null) > request.time;
    }

    // SOLO EL CEO. La Dirección (que incluye al COO) comparte lo operativo, pero
    // el dinero y lo irreversible no: aprobar un retiro es autorizar un pago y la
    // papelera borra definitivo. Esconder el botón en el menú no alcanza — si el
    // permiso queda abierto acá, se puede hacer igual por SDK.
    function esCEO() {
      return isAdmin() || (
        request.auth != null &&
        perfil().get('rank', '') == 'ceo' &&
        perfil().get('status', '') == 'approved'
      );
    }

    // ¿El documento que se está tocando es el del CEO? Se chequea por rango Y por
    // correo: si el perfil del CEO todavía no tiene rango cargado, el correo lo
    // protege igual. Sirve para que el COO no pueda editarlo ni borrarlo.
    function esDocDelCEO() {
      return resource.data.get('rank', '') == 'ceo'
          || resource.data.get('email', '').lower() == 'fabricio9061@gmail.com';
    }

    // Propiedad de una gestión (para las reglas de Cerrado). Una lectura más, solo
    // cuando una gestión entra o sale de Cerrado.
    function propiedadDeGestion(g) {
      return get(/databases/$(database)/documents/properties/$(g.propertyId)).data;
    }
    // ¿La firma de esa propiedad ya está confirmada en el Mapa de cierres?
    function firmaConfirmadaDe(g) {
      return g.get('propertyId', '') != ''
          && propiedadDeGestion(g).get('cierreConfirmado', false) == true;
    }
    // ¿La propiedad está otra vez en el mercado? (por ejemplo, terminó el alquiler)
    function propiedadEnJuegoDe(g) {
      return g.get('propertyId', '') != ''
          && propiedadDeGestion(g).get('status', 'available') in ['available', 'reserved', 'tasacion', 'tasado'];
    }

    // ESTADO DE UNA PROPIEDAD. Un agente lo mueve solo entre los estados "en
    // juego" (Disponible, Reservada, En tasación, Tasada), o devuelve al mercado un
    // alquiler que terminó (Alquilada -> Disponible). Vendida y Alquilada salen de
    // confirmar la firma en el Mapa de cierres (lo hace el servidor) o las pone la
    // Dirección; Dada de baja y Cerró por afuera, la Dirección o el servidor.
    // Antes el estado no se controlaba acá: las pantallas no lo ofrecían, pero
    // desde el navegador se podía poner cualquiera, y eso saca (o vuelve a poner)
    // el aviso en los portales.
    function estadoEnJuego(s) {
      return s in ['available', 'reserved', 'tasacion', 'tasado'];
    }
    function cambioDeEstadoDeAgente() {
      return request.resource.data.get('status', 'available') == resource.data.get('status', 'available')
          || (estadoEnJuego(resource.data.get('status', 'available'))
              && estadoEnJuego(request.resource.data.get('status', 'available')))
          || (resource.data.get('status', '') == 'rented'
              && request.resource.data.get('status', '') == 'available');
    }

    // El agente asociado no pasa por clientes ni por el Mapa de cierres: él
    // mismo da de baja su propiedad (Dada de baja) y la vuelve a poner en el
    // mercado. Si con eso pasa su tope de 50, el servidor la vuelve a bajar
    // (controlarCupoAsociado en functions/index.js).
    function cambioDeEstadoDeAsociado() {
      return esAsociado()
          && resource.data.get('asociado', false) == true
          && (estadoEnJuego(resource.data.get('status', 'available')) || resource.data.get('status', '') == 'archived')
          && (estadoEnJuego(request.resource.data.get('status', 'available')) || request.resource.data.get('status', '') == 'archived');
    }

    // Las cuentas para cobrar viven en users/{uid}/privado/banco, que ven solo el
    // agente y la Dirección. El perfil lo lee todo el equipo: estas dos funciones
    // impiden volver a guardar ahí datos bancarios (agregarlos o cambiarlos).
    // Borrarlos sí se puede: así limpia el perfil la mudanza de Mis finanzas.
    function camposBancarios() {
      return ['cuentasBancarias', 'bancoNombre', 'cuentaTitular', 'cuentaCI',
              'cuentaNumero', 'cuentaMoneda', 'cuentaTipo'];
    }
    function sinDatosBancariosNuevos() {
      return !request.resource.data.diff(resource.data).addedKeys().hasAny(camposBancarios())
          && !request.resource.data.diff(resource.data).changedKeys().hasAny(camposBancarios());
    }

    // ============ USERS ============
    // El perfil completo lo leen el equipo y la Dirección. La web pública lee
    // "perfiles" (la copia sin datos internos) y las cuentas para cobrar viven
    // aparte, en users/{uid}/privado/banco.
    match /users/{userId} {
      // LECTURA: los agentes aprobados ven los perfiles aprobados (como antes),
      // cada uno ve el suyo y la Dirección ve todos. El público ya no: lee
      // "perfiles" (más abajo), la copia de cada agente sin datos internos.
      // Acá viven las cuentas bancarias (con la cédula), las tasaciones (con el
      // nombre del cliente y la dirección) y los cálculos guardados, y una regla
      // no puede esconder campos sueltos: quien lee el documento lo lee entero.
      // El asociado ve solo el suyo: el del resto del equipo trae tasaciones.
      allow read: if (resource.data.status == 'approved' && isInterno())
                  || (request.auth != null && request.auth.uid == userId)
                  || esDireccion();

      // Al registrarse, el usuario NO puede autoaprobarse ni elegir su cargo.
      // El rango de alta lo clava esta regla, no el navegador: se acepta SOLO
      // 'asesor_junior' (el escalón más bajo) o vacío.
      //
      // Por qué se sigue aceptando vacío: un navegador con el JS viejo en caché
      // manda el perfil sin 'rank', y si acá lo rechazáramos el registro se
      // rompería con un error de permisos difícil de diagnosticar. Cuando ya no
      // queden clientes viejos dando vueltas, se quita el '' de la lista y queda
      // obligatorio. Lo que NUNCA se acepta es un rango elegido a gusto.
      allow create: if request.auth != null && request.auth.uid == userId
                    && (isAdmin() ||
                        (request.resource.data.status == 'pending'
                         && request.resource.data.get('rank', '') in ['', 'asesor_junior']
                         && request.resource.data.get('role', '') == ''
                         && !request.resource.data.keys().hasAny(['asociadoHasta'])))
                    && !request.resource.data.keys().hasAny(camposBancarios());

      // Tres capas:
      //  1. El CEO por correo: sin restricciones. Es el dueño del organigrama.
      //  2. La Dirección (o sea el COO) administra al equipo, con tres candados:
      //     no toca el documento del CEO, no se cambia el rango a sí mismo, y no
      //     puede fabricar otro CEO. Sin esto, "COO = admin" significa que el COO
      //     puede ascenderse y degradarte, que es justo lo que no queremos.
      //  3. El propio usuario edita su perfil pero NO su estado, correo, cargo ni rango.
      // Además, nadie (tampoco el CEO) agrega o cambia datos bancarios en el perfil.
      allow update: if sinDatosBancariosNuevos() && (isAdmin()
                    || (esDireccion()
                        && !esDocDelCEO()
                        && request.resource.data.get('rank', '') != 'ceo'
                        && !(request.auth.uid == userId
                             && request.resource.data.get('rank', '') != resource.data.get('rank', '')))
                    || (request.auth != null && request.auth.uid == userId
                        && request.resource.data.status == resource.data.status
                        && request.resource.data.email == resource.data.email
                        && request.resource.data.get('role', '') == resource.data.get('role', '')
                        && request.resource.data.get('rank', '') == resource.data.get('rank', '')
                        && request.resource.data.get('asociadoHasta', null) == resource.data.get('asociadoHasta', null)));

      // Nadie se borra a sí mismo, y al CEO no lo borra nadie.
      allow delete: if isAdmin()
                    || (esDireccion() && !esDocDelCEO() && request.auth.uid != userId);

      // DESTACADOS (entitlements). El agente los LEE para ver cuántos slots
      // tiene, a qué propiedad va cada uno y hasta cuándo. No escribe nunca:
      // 'validUntil' es el invariante del sistema y si el cliente pudiera
      // tocarlo volvemos al agujero de los destacados infinitos.
      // Las subcolecciones NO heredan de match /users/{userId}: sin este bloque
      // el agente no podría ni leer sus propios destacados.
      // Las escribe activarDestacado/quitarDestacado con Admin SDK, que no pasa
      // por estas reglas.
      match /featuredEntitlements/{entId} {
        allow read: if esDireccion() || (request.auth != null && request.auth.uid == userId);
        allow write: if false;

        // Historial inmutable: sirve para responder "yo tenía X días y
        // desaparecieron". Ni el dueño puede editarlo.
        match /history/{eventId} {
          allow read: if esDireccion() || (request.auth != null && request.auth.uid == userId);
          allow write: if false;
        }
      }

      // Fotos del anexo de las tasaciones (relevamiento fotográfico). El perfil
      // de un agente aprobado se lee sin iniciar sesión, así que las fotos del
      // inmueble de un cliente no van ahí: van acá, una por documento
      // ({tasación}_{n}), y las ven solo el agente y la Dirección, que las
      // necesita para corregir la tasación y rehacer el PDF.
      match /tasacionFotos/{fotoId} {
        allow read, delete: if esDireccion() || (request.auth != null && request.auth.uid == userId);
        allow create, update: if (esDireccion() || (request.auth != null && request.auth.uid == userId && !esAsociado()))
                              && request.resource.data.keys().hasOnly(['tasId', 'n', 'img', 'titulo', 'desc', 'entera', 'fecha'])
                              && request.resource.data.tasId is string && request.resource.data.tasId.size() <= 80
                              && request.resource.data.n is int && request.resource.data.n >= 0 && request.resource.data.n < 9
                              && request.resource.data.img is string
                              && request.resource.data.get('titulo', '') is string && request.resource.data.get('titulo', '').size() <= 40
                              && request.resource.data.get('desc', '') is string && request.resource.data.get('desc', '').size() <= 120;
      }

      // Lo privado de cada tasación: el teléfono y el email del cliente, y las
      // consideraciones para la venta (ocupación, deudas, obras). Tampoco va en el
      // perfil: un documento por tasación, que ven solo el agente y la Dirección.
      match /tasacionPrivado/{tasId} {
        allow read, delete: if esDireccion() || (request.auth != null && request.auth.uid == userId);
        allow create, update: if (esDireccion() || (request.auth != null && request.auth.uid == userId && !esAsociado()))
                              && request.resource.data.keys().hasOnly(['tasId', 'cli', 'consid', 'fecha'])
                              && request.resource.data.tasId == tasId && tasId.size() <= 80
                              && request.resource.data.get('cli', {}) is map
                              && request.resource.data.get('cli', {}).keys().hasOnly(['tel', 'email'])
                              && request.resource.data.get('consid', {}) is map
                              && request.resource.data.get('consid', {}).keys().hasOnly(['conRegimen', 'conDjcu', 'conOcupacion', 'conTributos', 'conObras', 'conNotas']);
      }

      // Las cuentas para cobrar del agente (banco, número, titular y cédula).
      // Antes estaban en el perfil, que lee todo el equipo. Acá las ve y las
      // cambia solo el dueño; la Dirección las ve para transferir. La mudanza
      // (moverCuentasBancarias) usa Admin SDK y no pasa por estas reglas.
      match /privado/{docId} {
        allow read: if esDireccion() || (request.auth != null && request.auth.uid == userId);
        allow create, update: if request.auth != null && request.auth.uid == userId
                              && !esAsociado()
                              && docId == 'banco'
                              && request.resource.data.keys().hasOnly(['cuentas', 'updatedAt'])
                              && request.resource.data.cuentas is list
                              && request.resource.data.cuentas.size() <= 10;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ============ ADMIN DATA (comisiones, etc.) — SOLO admin ============
    match /adminData/{doc} {
      allow read, write: if esCEO();
    }

    // ============ REFERIDOS (quién refirió a quién + %) — SOLO admin ============
    // Doc id = uid del agente referido. Contiene referrerUid, pctSale, pctRent.
    match /referidos/{referredUid} {
      // El admin gestiona todo. Cada usuario puede leer: su propio doc (para saber
      // quién lo refirió) y los docs donde él es el referente (para calcular su
      // ganancia por referidos en su saldo). Escribir, solo el admin.
      allow read: if esDireccion()
                  || (isInterno()
                      && (request.auth.uid == referredUid
                          || resource.data.referrerUid == request.auth.uid));
      allow write: if esDireccion();
    }

    // ============ PROPERTIES ============
    match /properties/{propertyId} {
      // LECTURA: solo agentes aprobados (la Dirección también lo es). El público
      // lee "vitrina" (más abajo): la copia de cada propiedad sin datos internos.
      // Acá viven los cierres, los contratos con el nombre del inquilino, el
      // cliente propietario y los datos de los portales, y una regla no puede
      // esconder campos sueltos: quien lee el documento lo lee entero.
      // Las visitas y los clics de contacto se siguen sumando sin sesión (ver la
      // última condición de "update"): para escribir no hace falta poder leer.
      // El agente asociado lee SOLO las suyas (o en las que figura como agente):
      // la cartera de MALAVE, con sus dueños y cierres, no es para él. Para ver
      // el resto lee "vitrina", como el público.
      allow read: if isInterno()
                  || (isApproved()
                      && (resource.data.ownerId == request.auth.uid
                          || (resource.data.agents is list && request.auth.uid in resource.data.agents)));
      // El admin puede crear con cualquier ownerId: lo necesita la PAPELERA para
      // restaurar propiedades de los agentes (el doc vuelve con su dueño original).
      // 'asociado' marca la propiedad de un agente asociado: sus consultas le
      // llegan solo a él (functions/index.js) y cuenta para su tope de 50. El asociado
      // la tiene que crear con asociado == true y con la cuota al día; el resto
      // del equipo, sin la marca. Después nadie la cambia desde el navegador.
      allow create: if esDireccion()
                    || (isApproved()
                        && request.resource.data.ownerId == request.auth.uid
                        && estadoEnJuego(request.resource.data.get('status', 'available'))
                        && (esAsociado()
                            ? (request.resource.data.get('asociado', false) == true && asociadoAlDia())
                            : request.resource.data.get('asociado', false) == false));
      allow update: if (isApproved()
                        && (resource.data.ownerId == request.auth.uid
                            || (resource.data.agents is list && request.auth.uid in resource.data.agents)
                            || esDireccion())
                        && !request.resource.data.diff(resource.data).affectedKeys()
                             .hasAny(['ownerId', 'asociado', 'mlItemId', 'mlStatus', 'mlPermalink',
                                      'mlPublishing', 'mlPublishingAt', 'cierreConfirmado',
                                      // DESTACADOS: solo los escribe el servidor.
                                      // El cupo depende del rango y del vencimiento, y eso
                                      // no se puede verificar desde el navegador. Sin esta
                                      // línea, cualquier agente se pone featured:true por
                                      // SDK y el sistema de cupos es decorativo.
                                      'featured', 'featuredHasta', 'featuredDesde', 'featuredPor',
                                      // 'extraPago' marca el destacado comprado con puntos.
                                      // activarDestacado permite UN extra a la vez y lo detecta
                                      // leyendo este campo. Sin bloquearlo, el agente lo pone en
                                      // false por SDK y se compra un segundo extra: paga los 2
                                      // puntos igual, pero rompe el tope de simultaneidad que
                                      // existe para que no se sature la vitrina.
                                      // El cliente NO lo escribe en ningún flujo (verificado en
                                      // todo el repo): solo lo escribe activarDestacado con el
                                      // Admin SDK, que no pasa por estas reglas.
                                      'extraPago',
                                      // CIERRES: el historial de cierres confirmados (siguen
                                      // sumando en las finanzas), las reservas que se cayeron y
                                      // qué gestión reservó la propiedad los escribe solo el
                                      // servidor (sincronizarCierresPropiedad y el trigger de
                                      // gestiones). Si el navegador pudiera tocarlos, un agente
                                      // se inventaba cierres "anteriores" que suman a su saldo.
                                      'cierresAnteriores', 'tieneCierresAnteriores',
                                      'reservasCaidas', 'reservadaPorGestion'])
                        // Un cierre ya CONFIRMADO (firmado y contado en Mis Finanzas,
                        // Recompensas y Rentabilidad) solo lo cambia la Dirección. Sin
                        // esto, el agente le subía la ganancia por SDK después de confirmado.
                        && (esDireccion()
                            || resource.data.get('cierreConfirmado', false) != true
                            || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['cierre']))
                        // El estado: ver cambioDeEstadoDeAgente() arriba.
                        && (esDireccion() || cambioDeEstadoDeAgente() || cambioDeEstadoDeAsociado())
                        // Asociado con la cuota vencida: no edita.
                        && (!esAsociado() || asociadoAlDia()))
                    || (esDireccion()
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['cierre', 'cierreConfirmado', 'status', 'updatedAt']))
                    // El AGENTE ASOCIADO confirma él mismo la firma de SUS propiedades
                    // (o la vuelve atrás): sus operaciones no pasan por la Dirección ni
                    // suman en los números de MALAVE.
                    || (esAsociado() && isApproved() && asociadoAlDia()
                        && resource.data.get('asociado', false) == true
                        && resource.data.ownerId == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['cierre', 'cierreConfirmado', 'status', 'updatedAt']))
                    // Contadores públicos: SOLO de a uno hacia arriba (lo que hace
                    // FieldValue.increment(1)). Antes se podía poner cualquier valor
                    // (un millón, negativo o un texto) sin iniciar sesión.
                    || (request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['views', 'contactClicks'])
                        && request.resource.data.get('views', 0) is number
                        && request.resource.data.get('contactClicks', 0) is number
                        && request.resource.data.get('views', 0) >= resource.data.get('views', 0)
                        && request.resource.data.get('views', 0) <= resource.data.get('views', 0) + 1
                        && request.resource.data.get('contactClicks', 0) >= resource.data.get('contactClicks', 0)
                        && request.resource.data.get('contactClicks', 0) <= resource.data.get('contactClicks', 0) + 1);
      allow delete: if esDireccion();

      // Comentarios públicos del aviso. Ninguna pantalla los escribe hoy, y un
      // 'create: if true' sin validar era una puerta pública para cargar
      // cualquier cosa de cualquier tamaño. Se cierra hasta que haya una función.
      match /comments/{commentId} {
        allow read: if true;
        allow create: if false;
        allow update, delete: if request.auth != null &&
                              (resource.data.userId == request.auth.uid || esDireccion());
      }
    }

    // ============ VITRINA PÚBLICA ============
    // Copia de cada propiedad con SOLO lo que se muestra al público (fotos,
    // precio, barrio, características). La escriben las funciones del
    // servidor (sincronizarVitrina, rehacerVitrina y repasoVitrina) con Admin
    // SDK, que no pasa por estas reglas. Desde el navegador nadie la escribe.
    match /vitrina/{propertyId} {
      allow read: if true;
      allow write: if false;
    }

    // ============ PERFILES PÚBLICOS ============
    // Copia de cada agente aprobado con SOLO lo que se muestra al público
    // (nombre, foto, rango, contacto, redes, descripción). La escriben las
    // funciones del servidor (sincronizarPerfil, rehacerPerfiles y
    // repasoPerfiles) con Admin SDK. Desde el navegador nadie la escribe.
    match /perfiles/{userId} {
      allow read: if true;
      allow write: if false;
    }

    // ============ PAPELERA (propiedades borradas) — SOLO admin ============
    // Las copias las escribe la Cloud Function al borrar (Admin SDK, no pasa por
    // acá). Desde papelera.html el admin las lee, restaura o elimina definitivo.
    match /papelera/{id} {
      allow read, write: if esCEO();
    }

    // ============ CLIENTS (CRM) — solo aprobados ============
    // El equipo de MALAVE ve todos. El AGENTE ASOCIADO tiene su propio CRM: ve,
    // carga y edita SOLO los clientes que cargó él (createdBy o agentId), nunca
    // los de MALAVE. Para saber si un teléfono ya es cliente de MALAVE usa
    // checkClientPhone (functions/index.js), que solo le contesta sí o no.
    // Las consultas de clientes.html filtran por createdBy / agentId: así la
    // regla puede probar que cada resultado es suyo.
    function esClienteDelAsociado(c) {
      return esAsociado() && isApproved()
          && (c.get('createdBy', '') == request.auth.uid || c.get('agentId', '') == request.auth.uid);
    }
    // "También lo trabajan" (enLista): cada agente se suma o se saca SOLO a sí
    // mismo. Sacar a OTRO agente (por ejemplo, uno que quedó por error) es de la
    // Dirección. Se mira qué entradas salieron y cuáles entraron: a lo sumo una
    // de cada lado, y las dos tienen que ser del que escribe (al volver a
    // sumarse, su entrada vieja sale y entra la nueva).
    function enListaSoloLaMia() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['enLista'])
          || (soloMiaEn(resource.data.get('enLista', []).removeAll(request.resource.data.get('enLista', [])))
              && soloMiaEn(request.resource.data.get('enLista', []).removeAll(resource.data.get('enLista', []))));
    }
    function soloMiaEn(l) {
      return l.size() == 0
          || (l.size() == 1 && l[0] is map && l[0].get('uid', '') == request.auth.uid);
    }
    match /clients/{clientId} {
      allow read: if isInterno() || esClienteDelAsociado(resource.data);
      allow create: if isInterno()
                    || (esAsociado() && isApproved()
                        && request.resource.data.get('createdBy', '') == request.auth.uid
                        && request.resource.data.get('agentId', request.auth.uid) == request.auth.uid
                        && request.resource.data.get('ownerId', request.auth.uid) == request.auth.uid);
      allow update: if esDireccion()
                    || (isInterno() && enListaSoloLaMia())
                    || (esClienteDelAsociado(resource.data)
                        && enListaSoloLaMia()
                        && !request.resource.data.diff(resource.data).affectedKeys()
                             .hasAny(['createdBy', 'agentId', 'ownerId']));
      allow delete: if esDireccion();
      match /notes/{noteId} {
        allow read, create: if isInterno()
                    || esClienteDelAsociado(get(/databases/$(database)/documents/clients/$(clientId)).data);
        allow update: if false;
        allow delete: if (isInterno() || esClienteDelAsociado(get(/databases/$(database)/documents/clients/$(clientId)).data))
                      && (resource.data.authorId == request.auth.uid || esDireccion());
      }
    }

    // ============ GESTIONES — solo aprobados ============
    // ¿De quién es la gestión? Del agente que la trabaja (agentId); en las viejas
    // que no lo tienen, de quien la creó (createdBy) o de ownerId. clientes.html
    // usa la misma cuenta (duenioGestion) para apagar los controles.
    function esDuenioDeGestion(g) {
      return request.auth != null && (
        g.get('agentId', '') == request.auth.uid
        || (g.get('agentId', '') in ['', null] && g.get('createdBy', '') == request.auth.uid)
        || (g.get('agentId', '') in ['', null] && g.get('createdBy', '') in ['', null]
            && g.get('ownerId', '') == request.auth.uid));
    }
    // El AGENTE ASOCIADO ve y mueve solo SUS gestiones (agentId), y solo las crea
    // sobre un cliente suyo y una propiedad suya.
    function gestionNuevaDelAsociadoOk() {
      return request.resource.data.get('clientId', '') != ''
          && esClienteDelAsociado(get(/databases/$(database)/documents/clients/$(request.resource.data.clientId)).data)
          && (request.resource.data.get('propertyId', '') == ''
              || get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.get('ownerId', '') == request.auth.uid);
    }
    match /gestiones/{gestionId} {
      allow read: if isInterno()
                  || (esAsociado() && isApproved() && resource.data.get('agentId', '') == request.auth.uid);
      // CERRADO es de la Dirección: lo pone al confirmar la firma en el Mapa de
      // cierres (el servidor pasa las gestiones solas y no pasa por estas reglas).
      // El agente marca Reservado cuando el cliente deja la seña. No crea gestiones
      // ya cerradas ni saca una de Cerrado, salvo el dueño que vuelve a En cartera
      // cuando su propiedad está otra vez en el mercado. Con la firma ya confirmada,
      // cerrar una gestión que quedó abierta es ponerla al día: se permite.
      //
      // DE QUIÉN ES: una gestión la mueve SOLO el agente que la trabaja o la
      // Dirección (CEO y COO). Antes bastaba con estar aprobado: cualquier agente
      // que abría el cliente de un compañero le podía marcar Reservado (y el
      // servidor reservaba la propiedad), cambiarle el avance o el rol, o
      // "sincronizarla". El traspaso a otro agente (agentId, createdBy, ownerId)
      // es solo de la Dirección. Y nadie crea gestiones a nombre de otro.
      allow create: if isApproved()
                    && (esDireccion()
                        || (request.resource.data.get('estadoGestion', '') != 'cerrado'
                            && request.resource.data.get('agentId', '') == request.auth.uid
                            && (!esAsociado() || gestionNuevaDelAsociadoOk())));
      allow update: if isApproved()
                    && (esDireccion()
                        || (esDuenioDeGestion(resource.data)
                            && !request.resource.data.diff(resource.data).affectedKeys()
                                 .hasAny(['agentId', 'createdBy', 'ownerId'])
                            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['estadoGestion'])
                                || (request.resource.data.get('estadoGestion', '') != 'cerrado'
                                    && resource.data.get('estadoGestion', '') != 'cerrado')
                                || (request.resource.data.get('estadoGestion', '') == 'cerrado'
                                    && firmaConfirmadaDe(resource.data))
                                || (resource.data.get('estadoGestion', '') == 'cerrado'
                                    && request.resource.data.get('estadoGestion', '') == 'cartera'
                                    && propiedadEnJuegoDe(resource.data)))));
      allow delete: if isApproved() &&
                    (resource.data.createdBy == request.auth.uid || esDireccion());
    }

    // ============ COMPARTIDAS — solo aprobados ============
    match /compartidas/{id} {
      allow read: if isInterno();
      allow create: if isInterno();
      allow update: if isInterno();
      allow delete: if isInterno() &&
                    (resource.data.createdBy == request.auth.uid || esDireccion());
    }

    // ============ PORTAL ACCOUNTS — SOLO el CEO ============
    // Usuarios y contraseñas de las cuentas oficiales (portales, herramientas).
    // Antes las leía todo agente aprobado: quien se iba, se las podía llevar.
    match /portalAccounts/{id} {
      allow read, write: if esCEO();
    }

    // ============ NOTIFICATIONS ============
    // Las crea SOLO el servidor (Admin SDK). Ninguna pantalla las crea, y con
    // 'request.auth != null' cualquier cuenta recién registrada (sin aprobar)
    // podía mandarle a cualquier agente un aviso falso ("transferí a…").
    // Al marcarlas leídas/resueltas no se puede cambiar de quién son.
    match /notifications/{notificationId} {
      allow create: if false;
      allow read: if request.auth != null &&
        (resource.data.ownerId == request.auth.uid ||
         resource.data.userId == request.auth.uid || esDireccion());
      allow update: if request.auth != null &&
        (resource.data.ownerId == request.auth.uid ||
         resource.data.userId == request.auth.uid || esDireccion())
        && request.resource.data.get('ownerId', null) == resource.data.get('ownerId', null)
        && request.resource.data.get('userId', null) == resource.data.get('userId', null);
      allow delete: if request.auth != null &&
        (resource.data.ownerId == request.auth.uid || esDireccion());
    }

    // ============ DOCUMENTOS Y ACADEMY — solo aprobados leen, admin escribe ============
    match /documentos/{id} {
      allow read: if isInterno();
      allow write: if esDireccion();
    }
    // La Academy la ven también los agentes asociados.
    match /academy/{id} {
      allow read: if isApproved();
      allow write: if esDireccion();
    }

    // ============ NEWSLETTER (web pública) ============
    // La web ya no tiene newsletter (ver index.html): se cierra la escritura pública.
    match /newsletter/{id} {
      allow create: if false;
      allow read, delete: if esDireccion();
      allow update: if false;
    }

    // ============ VISITS (AGENDA) ============
    // Cada agente aprobado ve las suyas. El COO/CEO (y admin) ven las de todos.
    // Editar/borrar: solo el dueño del evento o el admin.
    match /visits/{visitId} {
      allow read: if (request.auth != null && resource.data.userId == request.auth.uid && isApproved())
                  || rangoVeTodo();
      allow create: if isApproved();
      allow update, delete: if (request.auth != null && request.auth.uid == resource.data.userId && isApproved())
                            || esDireccion();
    }

    // ============ LEADS DE VENTA (web pública) ============
    // Público (vender.html no pide login), pero acotado como los testimonios.
    // Antes era 'if true': se podía guardar cualquier campo, y un 'estado'
    // inventado se pintaba sin escapar en el panel de la Dirección (XSS).
    match /leadsVenta/{leadId} {
      allow create: if request.resource.data.keys().hasOnly(
             ['nombre','telefono','email','tipo','zona','mensaje','origen','estado','createdAt'])
        && request.resource.data.keys().hasAll(['nombre','telefono','estado'])
        && request.resource.data.estado == 'nuevo'
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 1 && request.resource.data.nombre.size() <= 80
        && request.resource.data.telefono is string
        && request.resource.data.telefono.size() >= 1 && request.resource.data.telefono.size() <= 40
        && request.resource.data.get('email', '') is string && request.resource.data.get('email', '').size() <= 120
        && request.resource.data.get('tipo', '') is string && request.resource.data.get('tipo', '').size() <= 30
        && request.resource.data.get('zona', '') is string && request.resource.data.get('zona', '').size() <= 120
        && request.resource.data.get('mensaje', '') is string && request.resource.data.get('mensaje', '').size() <= 2000
        && request.resource.data.get('origen', '') is string && request.resource.data.get('origen', '').size() <= 40;
      allow read, update, delete: if esDireccion();
    }

    // ============ TESTIMONIOS (web pública) ============
    match /testimonials/{testiId} {
      // LECTURA: solo los aprobados. Antes era 'if true', o sea que cualquiera
      // podía leer los PENDIENTES desde la consola del navegador aunque el sitio
      // no los mostrara. Un testimonio ofensivo ya era público antes de que
      // Dirección lo viera.
      // Las dos lecturas públicas (inicio y perfil de agente) ya filtran por
      // approved == true, así que esto no las rompe. El panel de admin lee todo
      // porque entra por esDireccion().
      allow read: if resource.data.approved == true || esDireccion();

      // CREACIÓN: la deja abierta al público a propósito (el formulario del sitio
      // no pide login), pero acotada. Antes solo se exigía approved == false, así
      // que se podía insertar un texto de un megabyte o campos arbitrarios.
      allow create: if request.resource.data.approved == false
        && request.resource.data.keys().hasOnly(
             ['name','role','text','target','approved','createdAt','agentId','agentName'])
        && request.resource.data.keys().hasAll(['name','text','target','approved'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 5
        && request.resource.data.text.size() <= 600
        && request.resource.data.target in ['home', 'agent']
        && (!('role' in request.resource.data.keys())
            || (request.resource.data.role is string && request.resource.data.role.size() <= 60))
        && (request.resource.data.target != 'agent'
            || (request.resource.data.agentId is string && request.resource.data.agentId.size() <= 60));

      // Aprobar, despublicar y borrar: solo Dirección. Sin cambios.
      allow update, delete: if esDireccion();
    }

    // ============ FOTOS DIARIAS DE MÉTRICAS — SOLO Dirección ============
    // properties/{id}/metricas/{fecha}: una foto por día de views, clics y
    // visitas de ML. Es lo que permite decir "subió esta semana" en vez de solo
    // "acumuló desde que se publicó".
    // Va como collection group porque la herramienta las lee todas de una en vez
    // de recorrer propiedad por propiedad. Las escribe el cron con Admin SDK.
    match /{path=**}/metricas/{fecha} {
      allow read: if esDireccion();
      allow write: if false;
    }

    // ============ CRUDOS DE PORTALES — SOLO Dirección, solo lectura ============
    // mlEventos: cada consulta de Mercado Libre. leadsPortales: cada lead de
    // InfoCasas. Las dos guardan propertyId y fecha, y a diferencia de las
    // notificaciones NO se borran, así que son la única fuente confiable para
    // medir qué propiedad genera consultas en los portales.
    // Escritura solo desde Cloud Functions con Admin SDK, que no pasa por estas
    // reglas: por eso 'write: false' y no rompe nada.
    match /mlEventos/{eventoId} {
      allow read: if esDireccion();
      allow write: if false;
    }
    match /leadsPortales/{leadId} {
      allow read: if esDireccion();
      allow write: if false;
    }

    // ============ POSTULACIONES — "Trabajá con nosotros" ============
    // Las crea cualquiera desde la web pública (nadie se postula estando
    // logueado), pero SOLO el CEO las lee: traen datos personales de gente que no
    // es cliente ni agente, y la decisión de contratar es suya.
    //
    // La creación va acotada igual que los testimonios: campos conocidos y con
    // largo máximo. Sin eso, un endpoint público de escritura acepta cualquier
    // cosa y de cualquier tamaño.
    match /postulaciones/{postId} {
      allow read: if esCEO();
      allow create: if request.resource.data.keys().hasOnly(
             ['nombre','email','telefono','experiencia','mensaje','cvRuta','cvNombre',
              'createdAt','estado'])
        && request.resource.data.keys().hasAll(['nombre','telefono','estado'])
        && request.resource.data.estado == 'nueva'
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 2
        && request.resource.data.nombre.size() <= 80
        && request.resource.data.telefono is string
        && request.resource.data.telefono.size() >= 6
        && request.resource.data.telefono.size() <= 30
        && (!('email' in request.resource.data.keys())
            || (request.resource.data.email is string && request.resource.data.email.size() <= 120))
        && (!('mensaje' in request.resource.data.keys())
            || (request.resource.data.mensaje is string && request.resource.data.mensaje.size() <= 1500))
        && (!('experiencia' in request.resource.data.keys())
            || (request.resource.data.experiencia is string && request.resource.data.experiencia.size() <= 60))
        /* Se guarda la RUTA del archivo, no la URL de descarga: pedir la URL es
           una lectura y la regla de Storage solo deja leer al admin. El panel la
           resuelve cuando hace falta. */
        && (!('cvRuta' in request.resource.data.keys())
            || (request.resource.data.cvRuta is string && request.resource.data.cvRuta.size() <= 300));
      allow update, delete: if esCEO();
    }

    // ============ GASTOS DE LA AGENCIA — SOLO Dirección ============
    // Sueldos, BPS, alquiler y demás costos fijos. Es información sensible del
    // negocio: ni siquiera los agentes aprobados la ven. Los ingresos, en cambio,
    // salen de properties y no necesitan regla nueva.
    match /agencyGastos/{gastoId} {
      allow read, write: if esDireccion();
    }

    // ============ RECOMPENSAS (catálogo) — aprobados leen, admin escribe ============
    match /recompensas/{id} {
      allow read: if isInterno();
      allow write: if esDireccion();
    }

    // ============ CANJES (pedidos de recompensa) ============
    match /canjes/{id} {
      allow read: if isInterno()
                  && (resource.data.agenteUid == request.auth.uid || esDireccion());
      allow create: if isInterno()
                    && request.resource.data.agenteUid == request.auth.uid
                    && request.resource.data.status == 'pendiente';
      allow update, delete: if esDireccion();
    }

    // ============ RETIROS (solicitudes de cobro del agente) ============
    // Modelo de dinero: el agente SOLO puede crear solicitudes a su nombre, en
    // estado 'pendiente', con monto > 0. No puede aprobar, cambiar el monto, la
    // moneda ni el estado una vez creada: eso lo hace exclusivamente el admin
    // (pendiente -> aprobado/rechazado -> pagado). Así el saldo disponible que
    // muestra la app no se puede falsear desde el cliente.
    match /retiros/{id} {
      allow read: if isApproved()
                  && (resource.data.agenteUid == request.auth.uid || esCEO());
      allow create: if isInterno()
                    && request.resource.data.agenteUid == request.auth.uid
                    && request.resource.data.status == 'pendiente'
                    && request.resource.data.monto is number
                    && request.resource.data.monto > 0
                    && (request.resource.data.moneda == 'USD' || request.resource.data.moneda == 'UYU');
      // El agente puede CANCELAR su propia solicitud mientras siga pendiente
      // (sin tocar monto/moneda). Todo lo demás (aprobar, rechazar, pagar) es del admin.
      allow update: if esCEO()
                    || (isApproved()
                        && resource.data.agenteUid == request.auth.uid
                        && resource.data.status == 'pendiente'
                        && request.resource.data.status == 'cancelado'
                        && request.resource.data.monto == resource.data.monto
                        && request.resource.data.moneda == resource.data.moneda);
      allow delete: if esCEO();
    }

    // ============ AJUSTES FINANCIEROS (correcciones de saldo o puntos) ============
    // Los carga el CEO desde el panel del agente, con motivo y autor. Cada agente
    // lee los suyos: suman o restan en su saldo (Mis Finanzas) y en sus puntos
    // (Recompensas). Antes no había regla y la app no los podía leer ni guardar.
    match /ajustesFinancieros/{id} {
      allow read: if esCEO()
                  || (isInterno() && resource.data.agenteUid == request.auth.uid);
      allow create, update, delete: if esCEO();
    }

    // ============ COMPROBANTES (recibo de la seña y carta de pago) ============
    // Los arma el Mapa de cierres con los datos de la reserva: quién dejó la seña
    // (nombre y cédula), la comisión y la seña. Esos datos del cliente NO van en la
    // propiedad, que es pública: van acá, y solo los leen el agente de la operación
    // y la Dirección. Recursos los abre para descargar el PDF.
    // El agente emite y corrige el recibo de SU reserva; la carta de pago (cuando se
    // confirma la firma) es de la Dirección. Borrar, solo la Dirección.
    match /comprobantes/{id} {
      allow read: if isApproved()
                  && (resource.data.agenteUid == request.auth.uid || esDireccion());
      allow create: if esDireccion()
                    || (isApproved()
                        && request.resource.data.agenteUid == request.auth.uid
                        && request.resource.data.tipo == 'reserva');
      allow update: if esDireccion()
                    || (isApproved()
                        && resource.data.agenteUid == request.auth.uid
                        && resource.data.tipo == 'reserva'
                        && request.resource.data.agenteUid == request.auth.uid
                        && request.resource.data.tipo == 'reserva');
      allow delete: if esDireccion();
    }

    // ============ DOCUMENTOS GENERADOS (registro de cada PDF) ============
    // Cada PDF que sale de Generar documentos (descargado o enviado) queda acá:
    // quién, cuándo, de qué propiedad y de qué personas, y el enlace al archivo;
    // en /versiones, los datos del formulario de cada versión. Trae cédulas,
    // direcciones y cuentas: lo leen SOLO la Dirección y quien lo generó (nunca
    // público, nunca en la propiedad).
    // No se borra ni se pisa: volver a generarlo (o corregirlo) AGREGA una versión;
    // las anteriores quedan tal cual.
    // - get: leer uno. Un documento que todavía no existe se puede "leer" (vacío):
    //   la app lo pide al guardar la primera versión.
    // - list: la lista. Un agente solo puede pedirla filtrando por su uid.
    match /documentosGenerados/{docId} {
      allow get: if isApproved()
                 && (resource == null
                     || esDireccion()
                     || resource.data.autorUid == request.auth.uid);
      allow list: if isApproved()
                  && (esDireccion() || resource.data.autorUid == request.auth.uid);
      // Generar documentos no es para el agente asociado.
      allow create: if isInterno()
                    && request.resource.data.autorUid == request.auth.uid
                    && request.resource.data.version == 1
                    && request.resource.data.versiones is list
                    && request.resource.data.versiones.size() == 1;
      allow update: if isInterno()
                    && (esDireccion() || resource.data.autorUid == request.auth.uid)
                    && request.resource.data.autorUid == resource.data.autorUid
                    && request.resource.data.creado == resource.data.creado
                    && request.resource.data.tipo == resource.data.tipo
                    && request.resource.data.clave == resource.data.clave
                    && request.resource.data.version == resource.data.version + 1
                    && request.resource.data.versiones is list
                    && request.resource.data.versiones.size() == resource.data.versiones.size() + 1
                    && request.resource.data.versiones[0:resource.data.versiones.size()] == resource.data.versiones;
      allow delete: if false;

      // Los datos del formulario de cada versión (para poder corregirlo).
      match /versiones/{n} {
        allow read: if isApproved()
                    && (esDireccion()
                        || get(/databases/$(database)/documents/documentosGenerados/$(docId)).data.autorUid == request.auth.uid);
        allow create: if isInterno()
                      && request.resource.data.porUid == request.auth.uid
                      && string(request.resource.data.n) == n
                      && getAfter(/databases/$(database)/documents/documentosGenerados/$(docId)).data.version == request.resource.data.n
                      && (esDireccion()
                          || getAfter(/databases/$(database)/documents/documentosGenerados/$(docId)).data.autorUid == request.auth.uid);
        allow update, delete: if false;
      }
    }

    // ============ CONFIG — aprobados leen, admin escribe ============
    match /config/{doc} {
      allow read: if isInterno();
      allow write: if esDireccion();
    }
  }
}
